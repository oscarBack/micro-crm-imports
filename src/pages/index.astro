---
import "@/styles/global.css";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Micro CRM Imports</title>
  </head>
  <body class="bg-base-200 text-base-content">
    <main class="mx-auto flex min-h-screen max-w-3xl flex-col items-start justify-center gap-6 p-6">
      <h1 class="text-3xl font-bold">Micro CRM Imports Foundation</h1>
      <p class="text-base-content/80">
        Batch 1 bootstrap is active. Sign in with Clerk, then access the admin foundation.
      </p>
      <div class="flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/sign-in">Sign in</a>
        <a class="btn btn-outline" href="/admin">Open admin</a>
      </div>
    </main>
  </body>
</html>
